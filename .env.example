# FlowManager 환경 설정 예시
# 이 파일을 .env로 복사한 뒤 운영 환경에 맞게 값을 수정하세요.
# 비밀값은 이 파일에 넣지 말고 운영체제의 안전한 환경 변수나 별도 비밀 저장소를 사용하세요.

# -----------------------------------------------------------------------------
# 1. 화면에 표시되는 서비스 정보
#    환경설정 화면에서 로그인 후 변경할 수 있습니다.
# -----------------------------------------------------------------------------
WORKFLOW_MANAGER_NAME="FlowManager"
WORKFLOW_MANAGER_TAGLINE="Self-hosted workflow manager"
WORKFLOW_MANAGER_TITLE="서버의 반복 작업을 한 흐름으로..."
WORKFLOW_MANAGER_DESCRIPTION="프로젝트별 셸 워크플로우를 구성하고 실행 상태와 로그를 한곳에서 추적하세요."

# -----------------------------------------------------------------------------
# 2. 서버가 요청을 받을 주소
#    리버스 프록시가 같은 서버에 있으면 HOST는 127.0.0.1을 사용하세요.
#    다른 내부 기기에서 FlowManager에 직접 접속할 때만 private을 고려하세요.
# -----------------------------------------------------------------------------
HOST="127.0.0.1"
PORT="3000"
WORKFLOW_MANAGER_ACCESS_MODE="local"

# -----------------------------------------------------------------------------
# 3. 브라우저 공개 주소와 패스키 설정
#    로컬 개발은 아래 localhost 값을 사용합니다.
#    ORIGIN은 scheme과 포트를 포함하고, RP_ID는 도메인만 입력합니다.
#    예: http://localhost:3000 / localhost
# -----------------------------------------------------------------------------
WORKFLOW_MANAGER_ORIGIN="http://localhost:3000"
WORKFLOW_MANAGER_RP_ID="localhost"
WORKFLOW_MANAGER_RP_NAME="FlowManager"
# 패스키 로그인 세션 유지 시간(시간 단위, 1~720). 변경 후 서버를 재시작하세요.
WORKFLOW_MANAGER_SESSION_TTL_HOURS="12"

# 리버스 프록시를 사용하는 운영 환경에서는 위 두 값을 다음처럼 바꾸세요.
# WORKFLOW_MANAGER_ORIGIN="https://flow.example.com"
# WORKFLOW_MANAGER_RP_ID="flow.example.com"

# -----------------------------------------------------------------------------
# 4. 데이터 저장 위치
#    SQLite, 실행 이력, 로그가 저장됩니다.
#    release 브랜치의 빌드 파일과 분리된 영속 디렉터리를 사용하세요.
# -----------------------------------------------------------------------------
WORKFLOW_MANAGER_DATA_DIR="/absolute/path/to/flow-manager/data"
WORKFLOW_MANAGER_DB="/absolute/path/to/flow-manager/data/workflow-manager.sqlite"

# launchd처럼 실행 위치가 .env가 있는 디렉터리와 다를 때는
# 서비스의 EnvironmentVariables에서 이 경로를 지정하세요.
# WORKFLOW_MANAGER_CONFIG_FILE="/var/lib/flow-manager/.env"

# -----------------------------------------------------------------------------
# 5. 빌드 산출물의 정적 웹 자산 위치 (선택)
#    index.js 옆에 web/ 디렉터리가 있으면 설정하지 않아도 됩니다.
#    별도 위치에 배포할 때만 주석을 해제하세요.
# -----------------------------------------------------------------------------
# WORKFLOW_MANAGER_PUBLIC_DIR="/opt/flow-manager/current/web"
